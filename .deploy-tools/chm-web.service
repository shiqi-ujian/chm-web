[Unit]
Description=chm-web CHM to static site server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/app
Environment=CHM_SITE=/var/chm-web/data/site
Environment=CHM_DATA=/var/chm-web/data/data
Environment=CHM_SEED=/root/app/docs
Environment=HOST=0.0.0.0
Environment=PORT=8080
# 生产建议：在 /etc/systemd/system/chm-web.env 中填写以下变量，再以
# `EnvironmentFile=-/etc/systemd/system/chm-web.env` 方式引入（避免明文写在服务文件/仓库中）。
# UPLOAD_TOKEN / EXPORT_TOKEN / ADMIN_TOKEN / PUBLIC_BASE_URL / SMTP_* / RATE_* / MAX_*
ExecStart=/usr/local/bin/node src/server.js
Restart=always
RestartSec=3
# 简单保护：防止 OOM 时系统卡死
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target