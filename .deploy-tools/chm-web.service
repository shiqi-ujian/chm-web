[Unit]
Description=chm-web CHM to static site server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/app
Environment=CHM_SITE=/var/chm-web/data/site
Environment=CHM_DATA=/var/chm-web/data/data
Environment=CHM_SEED=/root/app/docs
Environment=HOST=0.0.0.0
Environment=PORT=8080
ExecStart=/usr/local/bin/node src/server.js
Restart=always
RestartSec=3
# 简单保护：防止 OOM 时系统卡死
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
